# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Contentful > Settings > General settings > Space ID
CONTENTFUL_SPACE_ID=
# Contentful > Settings > API keys > Content Delivery API access token (read-only). Also set in Cloudflare Pages.
CONTENTFUL_ACCESS_TOKEN=
# Contentful > Account settings > CMA tokens. Local only, for `npm run cms:setup`. Never add to Cloudflare.
CONTENTFUL_MANAGEMENT_TOKEN=
# Optional. Cloudflare Pages > Settings > Builds > Deploy hooks. Lets `npm run cms:setup` register a
# Contentful webhook so publishing in Contentful rebuilds the live site automatically.
CLOUDFLARE_DEPLOY_HOOK_URL=
